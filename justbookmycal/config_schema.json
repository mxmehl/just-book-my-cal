{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "just-book-my-cal configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["SECRET_KEY", "OWNER_NAME", "OWNER_EMAIL", "SYSTEM_EMAIL", "ICS_FEEDS"],
  "properties": {
    "DATABASE_URI": { "type": "string" },
    "SECRET_KEY": { "type": "string", "minLength": 32 },
    "TRUSTED_PROXIES": { "type": "integer", "minimum": 0 },
    "OWNER_NAME": { "type": "string", "minLength": 1, "pattern": "^[^\\x00-\\x1f\\x7f\"]+$" },
    "OWNER_EMAIL": { "type": "string", "format": "email" },
    "TIMEZONE": { "type": "string", "minLength": 1 },
    "ICS_FEEDS": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^(https?|webcal)://" }
    },
    "FEED_CACHE_SECONDS": { "type": "integer", "minimum": 0 },
    "FEED_TIMEOUT_SECONDS": { "type": "integer", "minimum": 1 },
    "DURATIONS": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 5, "maximum": 480 }
    },
    "WORKING_HOURS": {
      "type": "object",
      "propertyNames": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] },
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]-([01][0-9]|2[0-3]):[0-5][0-9]$" }
      }
    },
    "SLOT_STEP_MINUTES": { "type": "integer", "minimum": 5, "maximum": 240 },
    "MIN_NOTICE_HOURS": { "type": "number", "minimum": 0 },
    "HORIZON_DAYS": { "type": "integer", "minimum": 1, "maximum": 365 },
    "BUFFER_MINUTES_BEFORE": { "type": "integer", "minimum": 0 },
    "BUFFER_MINUTES_AFTER": { "type": "integer", "minimum": 0 },
    "MAX_UPCOMING_PER_EMAIL": { "type": "integer", "minimum": 1 },
    "MEETING_URL": { "type": "string", "pattern": "^https?://" },
    "REMINDER_MINUTES": { "type": ["integer", "null"], "minimum": 0 },
    "EVENT_TITLE": { "type": "string", "minLength": 1 },
    "EVENT_DESCRIPTION": { "type": "string" },
    "EMAIL_BODY_BOOKER": { "type": "string", "minLength": 1 },
    "EMAIL_BODY_OWNER": { "type": "string", "minLength": 1 },
    "SYSTEM_EMAIL": { "type": "string", "format": "email" },
    "SYSTEM_NAME": { "type": "string", "pattern": "^[^\\x00-\\x1f\\x7f\"]*$" },
    "SMTP_HOST": { "type": "string" },
    "SMTP_PORT": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "SMTP_USER": { "type": "string" },
    "SMTP_PASS": { "type": "string" },
    "SMTP_STARTTLS": { "type": "boolean" },
    "RATE_LIMIT_POST": { "type": "string", "minLength": 1 }
  }
}
